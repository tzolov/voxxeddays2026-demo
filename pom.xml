<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath />
	</parent>

	<groupId>com.example</groupId>
	<artifactId>voxxeddays2026-demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>voxxeddays2026-demo</name>
	<description>VoxxedDays 2026 Spring AI Demo</description>

	<properties>
		<java.version>17</java.version>
		<spring-ai.version>2.1.0</spring-ai.version>
		<spring-ai-agent-utils.version>0.14.0</spring-ai-agent-utils.version>
		<spring-ai-decision-extensions.version>0.5.0</spring-ai-decision-extensions.version>
		<jena.version>5.4.0</jena.version>
	</properties>

	<modules>
		<module>common</module>
		<module>01-system-instructions</module>
		<module>02-structured-output</module>
		<module>03-chat-memory</module>		
		<module>04-prompt-stuffing</module>
		<module>05-rag</module>
		<module>05-1-modular-rag</module>
		<module>06-guardrails-safe-input</module>
		<module>07-guardrails-json</module>
		<module>07-1-built-in-guardrails-json</module>
		<module>07-2-guardrails-jev</module>
		<module>08-tools</module>
		<module>09-tools-with-memory</module>
		<module>10-tool-search-tool</module>
		<module>10-1-tool-search-tool-autoconfig</module>
		<module>11-agents-llm-as-a-judge</module>
		<module>11-1-agents-model-as-a-judge</module>
		<module>12-agents-tool-argument-augmenter</module>
		<module>13-agents-skills</module>
		<module>14-agents-todo-write</module>
		<module>15-agents-ask-user-question</module>
		<module>16-agents-subagent</module>
		<module>17-mcp/mcp-server</module>
		<module>17-mcp/mcp-client</module>
		<module>18-a2a/subagent-a2a-demo</module>
		<module>18-a2a/airbnb-agent</module>
		<module>19-auto-memory</module>
		<module>20-memory-session</module>
		<module>21-guardrails-ontology-checker</module>
		<module>22-bank-support-agent</module>
		<module>23-multimodality/23-multimodality-1-vision-chat</module>
		<module>23-multimodality/23-multimodality-2-image-generation</module>
		<module>23-multimodality/23-multimodality-3-speech-and-transcription</module>
		<module>23-multimodality/23-multimodality-4-audio-chat</module>
		<module>23-multimodality/23-multimodality-5-gemini-image-chat</module>
		<module>24-observability</module>
		<module>25-bank-agent-park-resume</module>

	</modules>

	<!-- Common dependencies inherited by all sub-modules -->
	<dependencies>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Netty DNS resolver for macOS -->
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-resolver-dns-native-macos</artifactId>
			<classifier>osx-aarch_64</classifier>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.example</groupId>
				<artifactId>common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springaicommunity</groupId>
				<artifactId>spring-ai-inspector-starter</artifactId>
				<version>0.0.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Decision model components (judge, self-refine, guardrail) on Spring AI's DecisionModel -->
			<dependency>
				<groupId>org.springaicommunity</groupId>
				<artifactId>spring-ai-decision-bom</artifactId>
				<version>${spring-ai-decision-extensions.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>


</project>