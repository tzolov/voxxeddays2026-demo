{
  "uid": "spring-ai-helpdesk",
  "title": "Spring AI",
  "description": "Spring AI model, token, tool, advisor and vector store metrics, with exemplars into Tempo traces.",
  "tags": [
    "spring-ai"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "application",
        "label": "Application",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "query": {
          "query": "label_values(gen_ai_client_operation_seconds_count, application)",
          "refId": "app"
        },
        "definition": "label_values(gen_ai_client_operation_seconds_count, application)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "textbox",
        "name": "price_claude_in",
        "label": "Claude $/1M input tokens",
        "query": "1",
        "current": {
          "text": "1",
          "value": "1"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "price_claude_out",
        "label": "Claude $/1M output tokens",
        "query": "5",
        "current": {
          "text": "5",
          "value": "5"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "price_gpt_in",
        "label": "GPT $/1M input tokens",
        "query": "0.25",
        "current": {
          "text": "0.25",
          "value": "0.25"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "price_gpt_out",
        "label": "GPT $/1M output tokens",
        "query": "2",
        "current": {
          "text": "2",
          "value": "2"
        },
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "JVM (Micrometer)",
      "type": "dashboards",
      "tags": [
        "jvm"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Models",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model calls / min",
      "description": "Chat model calls across all providers (a ChatClient call with tools makes several).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_operation_seconds_count{application=~\"$application\", gen_ai_operation_name=\"chat\"}[$__rate_interval])) * 60",
          "legendFormat": "calls",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model error rate",
      "description": "Share of model calls that ended in an error (e.g. a model that does not exist, a rate limit).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(gen_ai_client_operation_seconds_count{application=~\"$application\", gen_ai_operation_name=\"chat\", error!=\"none\"}[$__rate_interval])) / sum(rate(gen_ai_client_operation_seconds_count{application=~\"$application\", gen_ai_operation_name=\"chat\"}[$__rate_interval]))",
          "legendFormat": "errors",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens / min",
      "description": "Input plus output tokens per minute, all models.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_token_usage_total{application=~\"$application\", gen_ai_token_type!=\"total\"}[$__rate_interval])) * 60",
          "legendFormat": "tokens",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Estimated spend in this time range",
      "description": "Tokens in the selected range times the prices in the dashboard variables (USD per million tokens). Set the variables to your list prices.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(gen_ai_client_token_usage_total{application=~\"$application\", gen_ai_request_model=~\"claude.*\", gen_ai_token_type=\"input\"}[$__range])) * $price_claude_in + sum(increase(gen_ai_client_token_usage_total{application=~\"$application\", gen_ai_request_model=~\"claude.*\", gen_ai_token_type=\"output\"}[$__range])) * $price_claude_out + sum(increase(gen_ai_client_token_usage_total{application=~\"$application\", gen_ai_request_model=~\"gpt.*\", gen_ai_token_type=\"input\"}[$__range])) * $price_gpt_in + sum(increase(gen_ai_client_token_usage_total{application=~\"$application\", gen_ai_request_model=~\"gpt.*\", gen_ai_token_type=\"output\"}[$__range])) * $price_gpt_out) / 1e6",
          "legendFormat": "USD",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "ChatClient p95 (end to end)",
      "description": "95th percentile of a whole ChatClient call: advisors, retrieval, model round-trips and tools.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(spring_ai_chat_client_seconds_bucket{application=~\"$application\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
